# ==============================================================================
# ELITECRUIT PRODUCTION ENVIRONMENT CONFIGURATION
# Copy this file to .env or paste these key-value pairs into your hosting platform
# (e.g., Render, Railway, AWS ECS, DigitalOcean, Heroku)
# ==============================================================================

# Node Environment ('production' enables strict security & disables dev hints)
NODE_ENV=production

# Server Port (Render & Railway inject $PORT automatically; defaults to 5400)
PORT=5400

# PostgreSQL Database Connection String
# Example: postgresql://username:password@db-host.render.com:5432/elitecruit
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/elitecruit

# Set to true if your cloud database requires SSL (Render, Supabase, Neon, AWS RDS)
DATABASE_SSL=true

# Cryptographically Secure JWT Secret for signing auth tokens (at least 64 hex characters)
# Generate a fresh secret using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret_key_for_production

# Frontend Production Domain (allowed CORS origin, comma-separated if multiple)
# Example: https://elitecruit.com,https://elitecruit.vercel.app
FRONTEND_URL=https://your-frontend-domain.com

# Initial Administrator Credentials (provisioned on initial boot if no admin exists)
ADMIN_INITIAL_EMAIL=admin@yourdomain.com
ADMIN_INITIAL_PASSWORD=YourStrongAdminPassword123!

# ==============================================================================
# SMTP EMAIL CONFIGURATION (Required for Production 2FA Code Delivery)
# ==============================================================================
# For Gmail:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=yourname@gmail.com
#   SMTP_PASS=your-16-char-app-password
#   SMTP_FROM="EliteCruit Security" <yourname@gmail.com>
#
# For Resend (https://resend.com):
#   SMTP_HOST=smtp.resend.com
#   SMTP_PORT=587
#   SMTP_USER=resend
#   SMTP_PASS=re_123456789...
#   SMTP_FROM="EliteCruit Security" <noreply@yourdomain.com>
#
# For Brevo / Sendinblue (https://brevo.com):
#   SMTP_HOST=smtp-relay.brevo.com
#   SMTP_PORT=587
#   SMTP_USER=your-brevo-login@email.com
#   SMTP_PASS=your-brevo-smtp-key
#   SMTP_FROM="EliteCruit Security" <noreply@yourdomain.com>

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="EliteCruit Security" <noreply@elitecruit.com>

# Optional Gemini API Key for ATS resume intelligence and matching
GEMINI_API_KEY=
