# ==============================================================================
# ELITECRUIT FRONTEND PRODUCTION CONFIGURATION
# ==============================================================================

# If Frontend and Backend are deployed on the SAME domain (or reverse proxy),
# leave VITE_API_URL empty so that all requests route to relative /api endpoints.
# If Frontend is deployed on Vercel/Netlify and Backend is on Render/Railway,
# set this to your backend domain:
# VITE_API_URL=https://elitecruit-api.onrender.com
VITE_API_URL=
